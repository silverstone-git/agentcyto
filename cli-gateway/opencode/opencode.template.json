{
  "$schema": "https://opencode.ai/config.json",
  "model": "gateway/nemotron-super",
  "small_model": "gateway/nemotron-lightning",
  "provider": {
    "gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local gateway",
      "options": {
        "baseURL": "http://127.0.0.1:__PORT__/v1",
        "apiKey": "{file:__KEYFILE__}",
        "timeout": 900000,
        "headerTimeout": 900000,
        "chunkTimeout": 900000
      },
      "models": {
        "heavy":              { "name": "HEAVY (ordered fallback chain)", "tool_call": false, "limit": { "context": 200000,  "output": 32000 } },
        "heavy-tool":         { "name": "HEAVY tool-capable chain",     "tool_call": true,  "limit": { "context": 128000,  "output": 16384 } },
        "light":              { "name": "LIGHT (ordered fallback chain)", "tool_call": false, "limit": { "context": 128000,  "output": 16384 } },
        "light-tool":         { "name": "LIGHT tool-capable chain",     "tool_call": true,  "limit": { "context": 128000,  "output": 16384 } },
        "nemotron-super":     { "name": "Nemotron 3.5 Super VL (NVIDIA)", "tool_call": true, "limit": { "context": 128000,  "output": 16384 } },
        "nemotron-ultra":     { "name": "Nemotron 3 Ultra (NVIDIA)",  "tool_call": true,  "limit": { "context": 128000,  "output": 16384 } },
        "nemotron-lightning": { "name": "Nemotron 3.5 Lightning",     "tool_call": true,  "limit": { "context": 128000,  "output": 16384 } },
        "nemotron-bolt":      { "name": "Nemotron 3.5 Bolt",           "tool_call": true,  "limit": { "context": 128000,  "output": 16384 } },
        "gemini-flash":       { "name": "Gemini Flash",               "tool_call": true,  "attachment": true, "modalities": { "input": ["text", "image"], "output": ["text"] }, "limit": { "context": 1048576, "output": 65536 } },
        "gemini-flash-lite":  { "name": "Gemini Flash Lite",          "tool_call": true,  "limit": { "context": 1048576, "output": 65536 } },
        "muse-spark":         { "name": "Muse Spark (Meta API)",      "tool_call": true,  "attachment": true, "modalities": { "input": ["text", "image"], "output": ["text"] }, "limit": { "context": 1048576, "output": 131072 } },
        "muse-spark-cheap":   { "name": "Muse Spark contributor (API)", "tool_call": true, "limit": { "context": 1048576, "output": 131072 } },
        "muse-cli":           { "name": "Muse Code CLI (chat)",        "tool_call": false, "limit": { "context": 200000,  "output": 32000 } },
        "muse-cli-wonder":    { "name": "Muse Wonder via CLI",         "tool_call": false, "limit": { "context": 200000,  "output": 32000 } },
        "muse-cli-ember":     { "name": "Muse Ember via CLI",          "tool_call": false, "limit": { "context": 200000,  "output": 32000 } },
        "muse-agent":         { "name": "Muse Code agent (/workspaces/<conv>)", "tool_call": false, "limit": { "context": 200000, "output": 32000 } },
        "muse-agent-contributor": { "name": "Muse agent contributor", "tool_call": false, "limit": { "context": 200000, "output": 32000 } },
        "claude-cli":         { "name": "Claude via CLI (chat)",      "tool_call": false, "limit": { "context": 200000,  "output": 32000 } },
        "claude-cli-opus":    { "name": "Claude Opus via CLI (chat)", "tool_call": false, "limit": { "context": 200000,  "output": 32000 } },
        "claude-agent":       { "name": "Claude Code agent (/workspaces/<conv>)", "tool_call": false, "limit": { "context": 200000, "output": 32000 } },
        "agy-cli":            { "name": "Antigravity via CLI (chat)", "tool_call": false, "limit": { "context": 1000000, "output": 65536 } },
        "agy-agent":          { "name": "Antigravity agent (/workspaces/<conv>)", "tool_call": false, "limit": { "context": 1000000, "output": 65536 } }
      }
    }
  }
}
