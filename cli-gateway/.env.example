# Compose settings (no secrets here). Copy to .env and adjust.

# Host port the gateway listens on (bound to 127.0.0.1 only).
GATEWAY_PORT=4000

# Your host uid, so files the agent models write in WORKSPACE_DIR stay yours (`id -u`).
APP_UID=1000

# Folder the *-agent models may read and edit, mounted at /workspace.
WORKSPACE_DIR=./workspace

# Set to 0 if the Antigravity installer breaks the build; agy models then fail and fall back.
INSTALL_AGY=1

# Kill a CLI run after this many seconds.
CLI_TIMEOUT_SECONDS=900
# CLI processes allowed at once (keep low on small hosts).
CLI_MAX_PARALLEL=2
# What to do with the client's system prompt for CLI models: drop | append
CLI_SYSTEM_PROMPT=drop
GATEWAY_MEM_LIMIT=2g
